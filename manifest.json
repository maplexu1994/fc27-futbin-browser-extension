{
  "manifest_version": 3,
  "name": "FC27 FUTBIN Market Monitor",
  "version": "1.5.6",
  "author": "MapleShadow",
  "homepage_url": "https://github.com/maplexu1994/fc27-futbin-browser-extension",
  "description": "FUTBIN FC27 PC 市场监控、最近成交与价格范围提醒。作者 MapleShadow；允许免费转发，不可商用。",
  "permissions": ["storage", "tabs", "alarms", "notifications", "scripting"],
  "host_permissions": ["https://www.futbin.com/*"],
  "action": {
    "default_title": "FC27 FUTBIN 市场监控",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "monitor-icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.futbin.com/27/player/*"
      ],
      "js": ["sales-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
